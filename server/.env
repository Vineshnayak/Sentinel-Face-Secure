# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DB_NAME=sentinel_face

# Server Configuration
PORT=5001
FRONTEND_DIR=./client/dist

# CNN Model Settings
USE_YOLO=false
ENCRYPT_EMBEDDINGS=true
USE_QUANTIZATION=false

# Encryption Key (change in production)
ENCRYPTION_KEY=sentinel-face-secure-default-key-2024
